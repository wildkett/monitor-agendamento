# Copie para .env e preencha. O .env está no .gitignore.
# Os mesmos valores vão nos secrets do repositório no GitHub.

AGENDA_URL=https://site-do-convenio.com.br/Agenda
CONVENIO=Nome do Convênio
MATRICULA=
NOME_COMPLETO=
DATA_NASCIMENTO=
CPF=
SEXO=
EMAIL=
TELEFONE=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional. Se vazio, a lista vem de config/especialidades.json.
# No GitHub Actions preencha como secret, em uma linha só:
# ESPECIALIDADES=[{"nome":"CARDIOLOGIA","dataInicio":"2026-01-01","dataFim":"2026-03-31"}]
ESPECIALIDADES=

# Opcional. Com valor, registra as vagas sem mandar mensagem no Telegram.
# Use na primeira execução, com o state.json ainda vazio.
SEM_ALERTA=
